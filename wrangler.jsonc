{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "postdoc-researchzea",
	"main": "./worker/index.js",
	"compatibility_date": "2026-08-01",
	"triggers": {
		"crons": ["17 1,13 * * *"]
	},
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"html_handling": "force-trailing-slash",
		"not_found_handling": "404-page",
       
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "postdoc-researchzeal-db",
             
			"migrations_dir": "./migrations",
			"database_id": "5277602b-2646-483e-a42c-4f200597cc9a"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "SOURCE_COLLECTION_QUEUE",
				"queue": "postdoc-source-collection"
			}
		],
		"consumers": [
			{
				"queue": "postdoc-source-collection",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "postdoc-source-collection-dlq",
				"max_concurrency": 2
			}
		]
	},
	"routes": [
		{
			"pattern": "postdoc.researchzeal.com",
			"custom_domain": true
		}
	]
}
