{
  "name": "postdoc-researchzeal",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:worker": "npm run build && wrangler dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply postdoc-researchzeal-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply postdoc-researchzeal-db --remote",
    "db:seed:local": "wrangler d1 execute postdoc-researchzeal-db --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute postdoc-researchzeal-db --remote --file=./seed/seed.sql",
    "db:list:local": "wrangler d1 execute postdoc-researchzeal-db --local --command=\"SELECT id, title, country, deadline, is_demo FROM jobs ORDER BY posted_at DESC;\"",
    "db:list:remote": "wrangler d1 execute postdoc-researchzeal-db --remote --command=\"SELECT id, title, country, deadline, is_demo FROM jobs ORDER BY posted_at DESC;\""
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "wrangler": "^4.118.0"
  }
}
